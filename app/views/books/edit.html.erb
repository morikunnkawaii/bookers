<h1>Editing Book</h1>

<% if @book.errors.any? %>
  <%= @book.errors.count %>error
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @book do |f| %>
  <div class="field">
    <h4>本のタイトル</h4>
    <%= f.text_field :title %>
  </div>
  <div class="field">
    <h4>感想</h4>
    <%= f.text_field :body %>
  </div>
  <div class="submit">
    <%= f.submit 'Update Book' %>
  </div>

<% end %>
<div>
  <span>
    <%= link_to "Show",book_path(@book.id) %>
    |
    <%= link_to "Back", books_path %>
  </span>
</div>